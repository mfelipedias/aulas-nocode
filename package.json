    "@fontsource/instrument-serif": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide": "^1.52.0",
    "qrcode": "^1.5.4",
    "simple-icons": "^16.34.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
