{
  "name": "nocode-deck",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Deck web cinematografico das aulas ao vivo de No-Code Development Platforms",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5181",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
